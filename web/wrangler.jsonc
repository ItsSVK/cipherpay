{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "vault-web",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vault-web"
    }
  ],
  "observability": { "enabled": true },
  // Per-IP limit for the unauthenticated sign-in routes (see src/server/rate-limit.ts). Cloudflare only offers 10 s or 60 s periods.
  // 20 a minute is far above a person signing in (one nonce + one verify) but stops a loop from hammering the database.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault-web",
      // Id printed by `wrangler d1 create vault-web`. Local dev (`bun run dev` / `preview`) uses a local SQLite file and ignores it.
      "database_id": "558252a3-1853-40f3-b306-1ee6ae2bda4b",
      "migrations_dir": "drizzle"
    }
  ]
}
